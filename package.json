{
  "name": "hono-lambda-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "probe": "tsx scripts/probe.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && esbuild src/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.js && printf '{\"type\":\"module\"}\n' > dist/package.json"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
